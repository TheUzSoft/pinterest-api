{
  "openapi": "3.0.0",
  "info": {
    "title": "Pinterest API",
    "version": "1.0.0",
    "description": "Download images, videos, and stats from Pinterest Pins."
  },
  "servers": [
    {
      "url": "https://pinterest-api-pinterest-scraper-fast.p.rapidapi.com"
    }
  ],
  "paths": {
