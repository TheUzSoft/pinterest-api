{
  "name": "theuzsoft/pinterest-api-sdk",
  "description": "PHP and Laravel SDK package for Pinterest API",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "ext-curl": "*"
  },
  "autoload": {
    "psr-4": {
      "TheUzSoft\\\\Pinterest\\\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "TheUzSoft\\\\Pinterest\\\\PinterestServiceProvider"
      ],
      "aliases": {
        "Pinterest": "TheUzSoft\\\\Pinterest\\\\Facades\\\\Pinterest"
      }
    }
  }
}